<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-browser</TargetFramework>
    <RuntimeIdentifier>browser-wasm</RuntimeIdentifier>
    <AssemblyName>SAMERIDER.Browser</AssemblyName>
    <Version>1.06</Version>
    <InformationalVersion>1.06</InformationalVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <WasmMainJSPath>wwwroot/main.js</WasmMainJSPath>
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.22" />
    <PackageReference Include="Avalonia.Browser" Version="11.3.22" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.22" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" Version="3.119.1" />
    <ProjectReference Include="..\SAMERIDER.Core\SAMERIDER.Core.csproj" />
    <ProjectReference Include="..\SAMERIDER.Editor\SAMERIDER.Editor.csproj" />
  </ItemGroup>
</Project>
